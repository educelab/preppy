Bootstrap: docker
From: python:3.11-slim

%labels
  MAINTAINER Seth Parker <c.seth.parker@uky.edu>
  OS Debian

%files
  /tmp/preppy /usr/local/educelab/preppy

%post -c /bin/bash
  set -e
  # Basic installs
  apt update
  DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends \
      curl \
      gcc \
      g++ \
      git \
      make \
      nano \
      tzdata \
      vim \
      imagemagick \
      libosmesa6 \
      libgl1

  # ImageMagick resource limits. The stock Debian policy.xml caps the pixel
  # cache (1GiB memory / 2GiB map / 2GiB disk, 256MP area) well below our
  # gigapixel textures: a 16384x16384 source is 268MP, so it spills to disk and
  # then dies with "cache resources exhausted". Policy values are per-instance
  # *maximums*, so a run can still tighten them via MAGICK_MEMORY_LIMIT and
  # friends. Disk spill lands in MAGICK_TMPDIR (else TMPDIR, else /tmp) — point
  # that at scratch, not a small node tmpfs, when processing 32K sources.
  policy="$(ls /etc/ImageMagick-*/policy.xml)"
  sed -i -E \
      -e 's|(name="memory" value=)"[^"]*"|\1"16GiB"|' \
      -e 's|(name="map" value=)"[^"]*"|\1"32GiB"|' \
      -e 's|(name="disk" value=)"[^"]*"|\1"128GiB"|' \
      -e 's|(name="area" value=)"[^"]*"|\1"4GP"|' \
      -e 's|(name="width" value=)"[^"]*"|\1"128KP"|' \
      -e 's|(name="height" value=)"[^"]*"|\1"128KP"|' \
      "$policy"
  identify -list resource

  # Install nodejs
  curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
  DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends \
      nodejs
  node -v

  # Install KTX-Software (>= v5, provides `ktx create`; toktx was removed in v5),
  # built from source with the patches in docker/patches/ktx-software/ (preppy#5).
  # The basis_universal ETC1S encoder it vendors sums a cluster's colours in
  # float32, so large bright areas can be encoded as flat grey blocks; the release
  # .debs carry that bug. Keep KTX_VERSION / KTX_PATCHES in step with the
  # Dockerfile, and set the same PREPPY_KTX_PATCHES in %environment below.
  KTX_VERSION=5.0.0-rc2
  KTX_PATCHES="basisu-etc1-optimizer-double-average"
  PATCH_DIR=/usr/local/educelab/preppy/docker/patches/ktx-software
  found="$(ls ${PATCH_DIR}/*.patch | sed -E 's#.*/[0-9]+-(.*)\.patch$#\1#' | sort | xargs)"
  declared="$(echo ${KTX_PATCHES} | tr ', ' '\n\n' | sed '/^$/d' | sort | xargs)"
  [ "$found" = "$declared" ] || { echo "KTX_PATCHES ($declared) != patch files ($found)" >&2; exit 1; }
  DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends \
      ca-certificates cmake ninja-build
  git clone --depth 1 --branch "v${KTX_VERSION}" \
      https://github.com/KhronosGroup/KTX-Software.git /tmp/ktx-src
  for p in ${PATCH_DIR}/*.patch; do git -C /tmp/ktx-src apply --verbose "$p"; done
  # Release options as in KTX-Software's own Linux (x86_64) package job, tools only.
  cmake -S /tmp/ktx-src -B /tmp/ktx-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DKTX_FEATURE_TOOLS=ON -DKTX_FEATURE_TOOLS_CTS=OFF \
      -DKTX_FEATURE_TESTS=OFF -DKTX_FEATURE_LOADTEST_APPS=OFF \
      -DKTX_FEATURE_DOC=OFF -DKTX_FEATURE_JNI=OFF -DKTX_FEATURE_PY=OFF \
      -DBASISU_SSE=ON -DBASISU_OPENCL=OFF
  cmake --build /tmp/ktx-build
  cmake --install /tmp/ktx-build
  rm -rf /tmp/ktx-src /tmp/ktx-build /usr/local/include/ktx*.h /usr/local/include/KHR /usr/local/lib/cmake/ktx
  ldconfig
  ktx --version

  # Install the node-based tools.
  # New delivery toolchain: gltfpack (geometry). The KTX2 embed step uses a
  # bundled Node helper (preppy/node/embed.mjs) whose deps are installed below.
  # obj2gltf/gltf-pipeline are the deprecated legacy path, kept until it is removed.
  npm install -g gltfpack obj2gltf gltf-pipeline

  # Install the embed helper's npm deps (@gltf-transform/core + meshoptimizer)
  npm install --prefix /usr/local/educelab/preppy/preppy/node

  # Create a venv for this project
  python3 -m venv /usr/local/educelab/preppy/.venv/

  # Activate virtualenv
  source /usr/local/educelab/preppy/.venv/bin/activate

  # Update pip
  python3 -m pip install --upgrade pip wheel setuptools

  # Install preppy with the preview extra (trimesh + pyrender) so the default
  # thumbnail is a rendered model preview. pyrender renders offscreen via OSMesa
  # (libosmesa6, above) with PYOPENGL_PLATFORM=osmesa set in %environment; if the
  # GL backend fails on a given node the thumbnail falls back to a texture crop.
  python3 -m pip install --editable '/usr/local/educelab/preppy[preview]'

  # Make writable
  echo "Cleaning up installation directory..."
  chmod --recursive a+rw /usr/local/educelab/
  git config --global credential.helper cache
  git config --global credential.helper 'cache --timeout=3600'
  git config --global --add safe.directory /usr/local/educelab/preppy/

%environment
  # Headless offscreen GL backend for the pyrender model-preview thumbnail.
  export PYOPENGL_PLATFORM=osmesa
  # The patches ktx was built with (%post). preppy hashes them, and refuses ETC1S
  # without the encoder fix (preppy#5). Keep in step with KTX_PATCHES above.
  export PREPPY_KTX_PATCHES="basisu-etc1-optimizer-double-average"

%runscript
#!/bin/bash
  if [ $# -lt 1 ]; then
      echo "Usage: ./container <command>"
      exit 1
  fi

  source /usr/local/educelab/preppy/.venv/bin/activate
  exec "$@"

%help
  This container provides an environment for running DRI Voyager Preppy.
