{
  "name": "dri-viewer",
  "version": "0.1.0",
  "description": "Embeddable three.js web component for DRI multi-variant 3D objects (<dri-viewer>).",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/dri-viewer.js",
  "module": "./dist/dri-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dri-viewer.js"
    }
  },
  "scripts": {
    "copy-basis": "node scripts/copy-basis.mjs",
    "predev": "node scripts/copy-basis.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-basis.mjs",
    "build": "tsc --noEmit && vite build && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.169.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
