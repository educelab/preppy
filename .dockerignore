.github
.gitlab-ci.yml
.idea
.pytest_cache
.DS_Store
**/__pycache__
**/*.pyc
**/*.egg-info
**/venv
**/.venv
**/node_modules
singularity
spike
conductor
docs
*.sif
data
logs
